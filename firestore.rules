rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Iedereen mag lezen. Alleen de acht deelnemers hebben een eigen document.
    match /answers/{person} {
      allow read: if true;
      allow create, update: if person in ['kai','toobs','babbels','dubbel-d','yung-marie','raw-roya','tomba','melph']
        && request.resource.data.keys().hasOnly(['name','answers','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.answers is map
        && request.resource.data.answers.keys().size() <= 60
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }
  }
}
