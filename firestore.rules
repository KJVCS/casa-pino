rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isPerson(p) {
      return p in ['kai','toobs','babbels','dubbel-d','yung-marie','raw-roya','tomba','melph'];
    }

    // Keuzes: één document per deelnemer.
    match /answers/{person} {
      allow read: if true;
      allow create, update: if isPerson(person)
        && request.resource.data.keys().hasOnly(['name','answers','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.answers is map
        && request.resource.data.answers.keys().size() <= 60
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    // Ideeën: indiener blijft altijd dezelfde; helpers mag iedereen aanpassen.
    match /ideas/{id} {
      function ok(d) {
        return d.keys().hasOnly(['title','text','cat','by','leads','helpers','gone','createdAt','updatedAt'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 80
          && d.text is string && d.text.size() <= 500
          && d.cat in ['eten','avond','spel','overig']
          && isPerson(d.by)
          && d.leads is list && d.leads.size() <= 8
          && d.helpers is list && d.helpers.size() <= 8
          && d.gone is bool
          && d.createdAt is timestamp && d.updatedAt is timestamp;
      }
      allow read: if true;
      allow create: if ok(request.resource.data) && request.resource.data.gone == false;
      allow update: if ok(request.resource.data)
        && request.resource.data.by == resource.data.by
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Scouting: alleen met een geldige code schrijven, en pas na de deadline voor iedereen leesbaar.
    // VERVANG de codes hieronder door de echte (die staan niet in deze openbare repo).
    match /scout/{doc} {
      function codes() {
        return {'kai-0000':'kai','toobs-0000':'toobs','babbels-0000':'babbels','dubbel-d-0000':'dubbel-d',
                'yung-marie-0000':'yung-marie','tomba-0000':'tomba','raw-roya-0000':'raw-roya','melph-0000':'melph'};
      }
      function open() { return request.time < timestamp.date(2026, 11, 19); }
      allow get: if doc in codes().keys();
      allow list: if !open();
      allow create, update: if open() && doc in codes().keys()
        && request.resource.data.by == codes()[doc]
        && request.resource.data.keys().hasOnly(['by','self','duels','updatedAt'])
        && request.resource.data.self is map && request.resource.data.self.size() <= 4
        && request.resource.data.duels is list && request.resource.data.duels.size() <= 40
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }
  }
}
